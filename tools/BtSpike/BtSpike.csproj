<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Lantern.Tools.BtSpike</RootNamespace>
    <AssemblyName>BtSpike</AssemblyName>

    <!-- Definition of Done rule 1 applies to tools as well as to the product. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="InTheHand.Net.Bluetooth" Version="4.2.5" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Not a convenience: the spike has to probe the *same* service GUID and speak the *same* frame
      codec as the app, or a pass here proves nothing about Lantern.
    -->
    <ProjectReference Include="..\..\src\Lantern\Lantern.csproj" />
  </ItemGroup>

</Project>
