<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Lantern</RootNamespace>
    <AssemblyName>Lantern</AssemblyName>

    <!-- Definition of Done rule 1: compiles without warnings. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- F10: the two sounds the room makes. Copied next to the program rather than embedded, so that
         replacing a file changes the sound without changing the code - and so that the sound does not
         depend on whoever set up this machine having left the Windows sound scheme alone. -->
    <Content Include="Media\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="InTheHand.Net.Bluetooth" Version="4.2.5" />
    <!-- Colour emoji: Windows' own Segoe UI Emoji is a COLR/CPAL colour font, and only a DirectWrite-class
         rasteriser resolves its palette. GDI - which is what every WinForms control draws with - cannot;
         Skia is that rasteriser without hand-written COM interop. See docs/notes/the-face-that-came-out-in-colour.md -->
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
  </ItemGroup>

</Project>
