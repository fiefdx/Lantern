<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Lantern</RootNamespace>
    <AssemblyName>Lantern</AssemblyName>

    <!-- Definition of Done rule 1: compiles without warnings. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- The lantern, inside the executable. This is the picture Explorer shows for Lantern.exe, the one a
         taskbar jump list shows, and the one a window falls back to if nobody hands it another - none of which
         can be fixed at run time, because it is a resource baked into the file at build time. The frames are
         chosen and written by tools/make_icon.py, which says why a single 1254-pixel picture is not enough. -->
    <ApplicationIcon>Media\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- F10: the two sounds the room makes. Copied next to the program rather than embedded, so that
         replacing a file changes the sound without changing the code - and so that the sound does not
         depend on whoever set up this machine having left the Windows sound scheme alone. -->
    <Content Include="Media\*.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

    <!-- The same picture, beside the program as well as inside it, so that the windows can be given their icon
         by AppIcon and a person can change it without a rebuild - the reason the sounds are files too (F10).
         The two PNGs it was made from are deliberately not copied: 2.6 MB of art nobody reads at run time.
         See tools/make_icon.py and docs/notes/the-lantern-on-the-window.md. -->
    <Content Include="Media\icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="InTheHand.Net.Bluetooth" Version="4.2.5" />
    <!-- Colour emoji: Windows' own Segoe UI Emoji is a COLR/CPAL colour font, and only a DirectWrite-class
         rasteriser resolves its palette. GDI - which is what every WinForms control draws with - cannot;
         Skia is that rasteriser without hand-written COM interop. See docs/notes/the-face-that-came-out-in-colour.md -->
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
  </ItemGroup>

</Project>
