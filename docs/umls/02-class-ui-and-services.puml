@startuml
' Lantern - Class design, part 1 of 2: WinForms UI + the chat-service abstraction
' (why one base form serves both the host and the client window)
skinparam classAttributeIconSize 0
left to right direction

package "UI layer  (WinForms)" {
  class StartupForm <<form>> {
    - txtNickname : TextBox
    - lstServers : ListBox
    - btnScan : Button
    - btnJoin : Button
    - btnStartServer : Button
    + ScanAsync() : Task
    + StartServerAsync() : Task
    + JoinAsync() : Task
  }

  ' concrete, not abstract: design view cannot open an abstract class, and the shared layout
  ' is most of both chat windows (v1.0.4, docs/notes/design-view.md)
  class ChatForm <<form>> {
    # lstRooms : ListBox
    # lstMembers : ListBox
    # rtbChat : RichTextBox
    # txtMessage : TextBox
    # btnSend : Button
    # btnShare : Button
    # lblStatus : ToolStripStatusLabel
    # service : IChatService
    - pictures : List of PictureSpan
    - files : List of FileSpan
    - transfers : Dictionary of Guid, FileTransferJob
    - savedTo : Dictionary of Guid, string
    + OnSendClick()
    + OnShareClick()
    + OnRoomChanged()
    + TryOpenPictureAt(caret : int)
    + CanSaveSharedAt(caret : int) : bool
    + SaveSharedAtAsync(caret : int) : Task
    # AskForFolder(suggested : string) : string
    + BeginPictureUpload()
    + EndPictureUpload()
    + ConfirmQuit()
    # Append(m : Message)
    # BindServiceEvents()
    # RunOnUiThread(a : Action)
    # NewRoomMenuItem_Click()
    # DeleteRoomMenuItem_Click()
    # RenameRoomMenuItem_Click(name)
  }

  class HostForm <<form>> {
    - btnNew : Button
    - btnDelete : Button
    + OnNewRoomClick()
    + OnDeleteRoomClick()
    + OnRenameRoom(name)
  }

  class ClientForm <<form>> {
    - btnLeave : Button
  }

  ' v1.1: what a transcript entry looks like, and where a photo goes when it is opened
  ' v1.3: the small page a shared file gets in the transcript (docs/notes/sharing-in-and-out.md)
  class FilePlaceholder <<static>> {
    + {static} Width, Height : int
    + {static} InkColor, RuleColor : Color
    + {static} Bitmap(fileName) : Bitmap
    + {static} Label(fileName) : string
    + {static} InlineFor(fileName) : string
  }

  ' v1.5: a colourful emoji, rasterised from Windows' own emoji font - GDI cannot do it at all
  ' (docs/notes/the-face-that-came-out-in-colour.md)
  class ColorEmoji <<static>> {
    + {static} FontPath : string
    + {static} Available : bool
    + {static} IsEmoji(element) : bool
    + {static} Split(text) : IEnumerable~(string, bool)~
    + {static} Png(element, pixels) : byte[]
    + {static} InlineRtf(text, pixels) : string
  }

  class TranscriptStyle <<static>> {
    + {static} Headline(sentAt, sender) : string
    + {static} Content(entry) : string
    + {static} HeadlineColour, ContentColour : Color
    + {static} NoticeTimeColour, NoticeColour : Color
  }

  class PictureViewerForm <<form>> {
    - picture : PictureBox
    - scale : double
    + ShowZoom()
    + ZoomIn() / ZoomOut()
    + FitToWindow() / ActualSize()
    + SaveToDisk()
  }

  class NewRoomDialog <<dialog>> {
    - txtRoomName : TextBox
    + RoomName : string
  }

  class ConfirmDialog <<dialog>> {
    - lblMessage : Label
    + {static} ConfirmQuit(owner) : bool
    + {static} ConfirmDeleteRoom(owner, roomName) : bool
    + {static} ConfirmLeaveRoom(owner, roomName) : bool
  }

  class DesignTime <<design-time only>> {
    + {static} IsHosting() : bool
    + {static} ChatService(isHost : bool, window : string) : IChatService
    + {static} Confirmation(window : string) : (string, string)
    + {static} Picture() : PictureMessage
    + {static} Transport() : ITransportFactory
    + {static} KnownHosts() : IKnownHosts?
  }
}

interface IChatService <<interface>> {
  + Nickname : string
  + IsHost : bool
  + Rooms : ObservableCollection~Room~
  + Members : ObservableCollection~User~
  + StartAsync() : Task
  + ConnectAsync(e : ServerEndpoint) : Task
  + CreateRoomAsync(name : string) : Task
  ' a room is acted on by its identity: the name is what it is called,
  ' and the host may be changing that (v1.0.2, docs/notes/room-identity.md)
  + DeleteRoomAsync(roomId : Guid) : Task
  + RenameRoomAsync(roomId : Guid, newName : string) : Task
  + JoinRoomAsync(roomId : Guid?) : Task
  + SendAsync(m : Message) : Task
  + SendFileAsync(path : string) : Task
  + SaveReceivedFileAsync(job, path) : Task
  + ShutdownAsync() : Task
  + MessageReceived(Message)
  + RoomsChanged()
  + MembersChanged()
  + IncomingFile(FileTransferJob)
  + StatusChanged(string)
  + ConnectionLost(Exception)
}

package "Application core" {
  class ChatServer <<service>> {
    - rooms : List~Room~
    - sessions : ConcurrentDictionary~IClientLink, ClientSession~
    - store : IRoomStore
    - listener : IBtServer
    + StartAsync() : Task
    + CreateRoomAsync(name) : Task
    + DeleteRoomAsync(name) : Task
    + BroadcastAsync(room, m) : Task
    + SendToAsync(s, m) : Task
    # AcceptLoop() : Task
    # PersistAndBroadcastRooms()
  }

  class ChatClient <<service>> {
    - link : IClientLink
    - currentRoomId : Guid?
    + ConnectAsync(e) : Task
    + JoinRoomAsync(roomId : Guid?) : Task
    + SendAsync(m) : Task
    + SendFileAsync(path) : Task
    + CreateRoomAsync(name) : Task
    ' rejected: only the host may edit rooms
    # ReadLoopAsync() : Task
  }

  class ClientSession {
    - link : IClientLink
    - user : User
    - currentRoom : string
    + ReadLoopAsync() : Task
    + WriteAsync(f : Frame) : Task
    + Close()
  }

  class ServerBrowser <<service>> {
    + DiscoverAsync(t : TimeSpan) : Task
    ' returns List~ServerEndpoint~
  }

  class ServerEndpoint {
    + ServerName : string
    + DeviceAddress : string
    + ServiceId : Guid
  }

  class SoundNotifier <<service>> {
    - player : SoundPlayer
    + PlayAsync(wav : string) : Task
  }
}

ChatForm <|-- HostForm
ChatForm <|-- ClientForm
StartupForm ..> ChatForm : opens HostForm or ClientForm
StartupForm ..> ChatServer : role = host
StartupForm ..> ChatClient : role = client
StartupForm ..> ServerBrowser : "Scan"
HostForm ..> NewRoomDialog : "New" and Edit > New room
HostForm ..> ConfirmDialog : before deleting a room
ChatForm ..> TranscriptStyle : lays out every entry with
ChatForm --> PictureViewerForm : a double click on a photo's span
ChatForm o--> IChatService : never touches Bluetooth
StartupForm ..> DesignTime : loopback, no history, while drawn
ChatForm ..> DesignTime : a stand-in chat, only while drawn

ChatServer ..|> IChatService
ChatClient ..|> IChatService
ChatServer o--> ClientSession : 0..*
ChatServer ..> ServerEndpoint
ChatClient ..> ServerEndpoint : ConnectAsync(e)
ChatServer o--> SoundNotifier
ChatClient o--> SoundNotifier

note bottom of IChatService
  The host process builds a ChatServer, a client process builds a
  ChatClient; both are handed to the same ChatForm through
  IChatService. That is why the two wireframes are identical apart
  from New / Delete: only HostForm exposes room management.
end note

note top of ChatForm
  Events arrive from a background read loop, so every handler uses
  RunOnUiThread (Control.Invoke / IProgress~Double~). Send and Share
  are disabled while a Task is in flight to stop double sends.

  Since v1.1 an entry is a headline over its content, so a picture
  is recorded by the character span it was written into: the click
  knows only the text at the caret, and two photos from one sender
  in one minute have identical headlines.
end note

note bottom of DesignTime
  Every window grew a constructor with no arguments, because the
  Windows Forms designer builds a class in order to draw it. Each
  one asks DesignTime whether it is being drawn or being used:
  while drawn it gets a fake chat, loopback and no history file;
  anywhere else it throws. The program still cannot build a window
  with nothing behind it.
end note

@enduml
